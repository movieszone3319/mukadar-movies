<!DOCTYPE html>
<html lang="ur" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MUKADAR MOVIES ZONE</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root { --primary-color: #e50914; --bg-color: #0f1015; --card-bg: #181920; --text-color: #ffffff; --text-muted: #a0a0a0; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); padding-bottom: 30px; }
        header { position: sticky; top: 0; z-index: 100; background: rgba(15, 16, 21, 0.95); padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .logo { font-size: 1.1rem; font-weight: bold; color: var(--primary-color); }
        .logo span { color: #fff; }
        .search-box { position: relative; width: 60%; }
        .search-box input { width: 100%; padding: 8px 12px 8px 32px; border-radius: 20px; border: 1px solid #333; background: #222; color: #fff; font-size: 0.8rem; outline: none; }
        .search-box i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #888; font-size: 0.8rem; }
        .categories { display: flex; gap: 8px; padding: 12px 16px; overflow-x: auto; scrollbar-width: none; }
        .tab-btn { padding: 6px 14px; background: var(--card-bg); border: 1px solid #333; color: #fff; border-radius: 20px; font-size: 0.8rem; cursor: pointer; white-space: nowrap; }
        .tab-btn.active { background: var(--primary-color); border-color: var(--primary-color); }
        .movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 12px; padding: 0 16px; }
        .movie-card { background: var(--card-bg); border-radius: 8px; overflow: hidden; position: relative; cursor: pointer; }
        .movie-poster { width: 100%; aspect-ratio: 2/3; object-fit: cover; background: #222; display: block; }
        .movie-info { padding: 6px; }
        .movie-title { font-size: 0.8rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; overflow-y: auto; }
        .modal-content { width: 100%; max-width: 800px; margin: 0 auto; background: var(--bg-color); min-height: 100vh; }
        .close-btn { position: absolute; top: 10px; right: 15px; color: #fff; font-size: 1.5rem; z-index: 1010; cursor: pointer; background: rgba(0,0,0,0.5); width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .player-container { width: 100%; aspect-ratio: 16/9; background: #000; }
        iframe { width: 100%; height: 100%; border: none; }
        .media-details { padding: 16px; }
        .server-btn { padding: 6px 12px; background: #252836; border: 1px solid #444; color: #fff; border-radius: 4px; font-size: 0.75rem; cursor: pointer; margin-right: 5px; }
        .server-btn.active { background: var(--primary-color); border-color: var(--primary-color); }
        .ep-btn { padding: 6px; background: var(--card-bg); border: 1px solid #333; color: #fff; border-radius: 4px; font-size: 0.75rem; text-align: center; cursor: pointer; display: inline-block; margin: 3px; }
        .ep-btn.active { background: var(--primary-color); }
        .loader { text-align: center; padding: 20px; color: #aaa; grid-column: 1/-1; }
    </style>
</head>
<body>

    <header>
        <div class="logo"><i class="fas fa-play-circle"></i> MUKADAR <span>ZONE</span></div>
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search Movie or Series..." onkeyup="handleSearch()">
        </div>
    </header>

    <div class="categories">
        <button class="tab-btn active" onclick="changeCategory('popular', this)">🔥 Popular</button>
        <button class="tab-btn" onclick="changeCategory('hindi', this)">🇮🇳 Hindi Dubbed</button>
        <button class="tab-btn" onclick="changeCategory('series', this)">📺 Web Series</button>
    </div>

    <div style="padding: 10px 16px; font-weight: bold;" id="sectionHeading">Popular Movies</div>
    <div class="movie-grid" id="movieGrid"><div class="loader">Loading Movies...</div></div>

    <div class="modal" id="playerModal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal()">&times;</span>
            <div class="player-container"><iframe id="videoPlayer" allowfullscreen src=""></iframe></div>
            <div class="media-details">
                <h3 id="mTitle">Movie Title</h3>
                <p id="mOverview" style="font-size:0.8rem; color:#aaa; margin:10px 0;"></p>
                
                <div style="margin-bottom:15px;">
                    <span style="font-size:0.8rem; color:#aaa; display:block; margin-bottom:5px;">Select Server (Hindi / English):</span>
                    <button class="server-btn active" onclick="switchServer(1, this)">Server 1</button>
                    <button class="server-btn" onclick="switchServer(2, this)">Server 2</button>
                    <button class="server-btn" onclick="switchServer(3, this)">Server 3</button>
                </div>

                <div id="seriesControls" style="display:none;">
                    <select id="seasonSelect" onchange="loadEpisodes()" style="width:100%; padding:8px; background:#222; color:#fff; border:1px solid #444; margin-bottom:10px;"></select>
                    <div id="episodesGrid"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const API_KEY = '8470a720dd33a1e94472d0075d9c7924';
        const BASE_URL = 'https://api.themoviedb.org/3';
        let currentMedia = null, currentType = 'movie', currentSeason = 1, currentEpisode = 1, currentServer = 1;

        document.addEventListener('DOMContentLoaded', function() {
            fetchMovies('/movie/popular');
        });

        async function fetchMovies(endpoint, isTV) {
            if (isTV === undefined) isTV = false;
            var grid = document.getElementById('movieGrid');
            grid.innerHTML = '<div class="loader">Loading...</div>';
            try {
                var res = await fetch(BASE_URL + endpoint + '?api_key=' + API_KEY + '&language=hi-IN&page=1');
                var data = await res.json();
                renderGrid(data.results || [], isTV);
            } catch (err) {
                grid.innerHTML = '<div class="loader">Error loading content. Please check internet.</div>';
            }
        }

        function renderGrid(list, isTV) {
            if (isTV === undefined) isTV = false;
            var grid = document.getElementById('movieGrid');
            grid.innerHTML = '';
            if (!list || list.length === 0) {
                grid.innerHTML = '<div class="loader">No Content Found</div>';
                return;
            }

            list.forEach(function(item) {
                var title = item.title || item.name;
                var poster = item.poster_path ? 'https://image.tmdb.org/t/p/w500' + item.poster_path : 'https://via.placeholder.com/500x750?text=No+Poster';
                var mediaType = isTV || item.first_air_date ? 'tv' : 'movie';

                var card = document.createElement('div');
                card.className = 'movie-card';
                card.onclick = function() { openMedia(item.id, mediaType, title, item.overview); };
                card.innerHTML = '<img class="movie-poster" src="' + poster + '"><div class="movie-info"><div class="movie-title">' + title + '</div></div>';
                grid.appendChild(card);
            });
        }

        function changeCategory(cat, btn) {
            document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            if (cat === 'popular') fetchMovies('/movie/popular');
            else if (cat === 'hindi') fetchMovies('/discover/movie?with_original_language=hi');
            else if (cat === 'series') fetchMovies('/tv/popular', true);
        }

        var searchTimeout;
        function handleSearch() {
            clearTimeout(searchTimeout);
            var query = document.getElementById('searchInput').value.trim();
            if (query.length < 2) return;
            searchTimeout = setTimeout(async function() {
                try {
                    var res = await fetch(BASE_URL + '/search/multi?api_key=' + API_KEY + '&query=' + encodeURIComponent(query));
                    var data = await res.json();
                    renderGrid(data.results || []);
                } catch(e){}
            }, 500);
        }

        async function openMedia(id, type, title, overview) {
            currentMedia = id; currentType = type; currentSeason = 1; currentEpisode = 1;
            document.getElementById('mTitle').innerText = title;
            document.getElementById('mOverview').innerText = overview || '';
            document.getElementById('playerModal').style.display = 'block';

            if (type === 'tv') {
                document.getElementById('seriesControls').style.display = 'block';
                await loadSeasons(id);
            } else {
                document.getElementById('seriesControls').style.display = 'none';
            }
            updatePlayerUrl();
        }

        async function loadSeasons(tvId) {
            var seasonSelect = document.getElementById('seasonSelect');
            seasonSelect.innerHTML = '';
            try {
                var res = await fetch(BASE_URL + '/tv/' + tvId + '?api_key=' + API_KEY);
                var data = await res.json();
                if(data.seasons) {
                    data.seasons.forEach(function(s) {
                        if (s.season_number > 0) {
                            var opt = document.createElement('option');
                            opt.value = s.season_number; opt.innerText = 'Season ' + s.season_number;
                            seasonSelect.appendChild(opt);
                        }
                    });
                }
                loadEpisodes();
            } catch (err) { seasonSelect.innerHTML = '<option value="1">Season 1</option>'; loadEpisodes(); }
        }

        async function loadEpisodes() {
            currentSeason = document.getElementById('seasonSelect').value || 1;
            var epGrid = document.getElementById('episodesGrid');
            epGrid.innerHTML = 'Loading Episodes...';
            try {
                var res = await fetch(BASE_URL + '/tv/' + currentMedia + '/season/' + currentSeason + '?api_key=' + API_KEY);
                var data = await res.json();
                epGrid.innerHTML = '';
                if(data.episodes) {
                    data.episodes.forEach(function(ep) {
                        var btn = document.createElement('span');
                        btn.className = 'ep-btn ' + (ep.episode_number == currentEpisode ? 'active' : '');
                        btn.innerText = 'Ep ' + ep.episode_number;
                        btn.onclick = function() { currentEpisode = ep.episode_number; updatePlayerUrl(); };
                        epGrid.appendChild(btn);
                    });
                }
            } catch (err) { epGrid.innerHTML = 'Episodes unavailable'; }
        }

        function switchServer(num, btn) {
            document.querySelectorAll('.server-btn').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            currentServer = num;
            updatePlayerUrl();
        }

        function updatePlayerUrl() {
            var player = document.getElementById('videoPlayer');
            var url = '';
            if (currentType === 'movie') {
                if (currentServer === 1) url = 'https://vidsrc.to/embed/movie/' + currentMedia;
                else if (currentServer === 2) url = 'https://embed.su/embed/movie/' + currentMedia;
                else url = 'https://multiembed.mov/directstream.php?video_id=' + currentMedia + '&tmdb=1';
            } else {
                if (currentServer === 1) url = 'https://vidsrc.to/embed/tv/' + currentMedia + '/' + currentSeason + '/' + currentEpisode;
                else if (currentServer === 2) url = 'https://embed.su/embed/tv/' + currentMedia + '/' + currentSeason + '/' + currentEpisode;
                else url = 'https://multiembed.mov/directstream.php?video_id=' + currentMedia + '&tmdb=1&s=' + currentSeason + '&e=' + currentEpisode;
            }
            player.src = url;
        }

        function closeModal() {
            document.getElementById('playerModal').style.display = 'none';
            document.getElementById('videoPlayer').src = '';
        }
    </script>
</body>
</html>
